# Copy this file to .env (same folder as manage.py) and fill in real values.
# NEVER share or commit your real .env file.

# Make a new key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Local computer: True.  Live site: False
DEBUG=True

# Local:  127.0.0.1,localhost
# Live:   darlova.com,www.darlova.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Live only:  https://darlova.com,https://www.darlova.com
CSRF_TRUSTED_ORIGINS=

# Live only, AFTER the SSL certificate works (https://darlova.com opens with a padlock): True
SECURE_SSL_REDIRECT=False

# ---- Email (password reset codes) ----
# Create noreply@darlova.com in cPanel → Email Accounts, then fill these in.
# Leave EMAIL_HOST empty locally: emails are printed in the terminal instead.
EMAIL_HOST=mail.darlova.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@darlova.com
EMAIL_HOST_PASSWORD=the-mailbox-password
DEFAULT_FROM_EMAIL=Darlova <noreply@darlova.com>
